<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
   rest-api.xml  -  REST endpoint declarations (REST DSL)
  ============================================================================
   The HTTP entry points of all six APIs. Nothing but protocol adaptation happens here:
   the request becomes an Exchange and is handed to a direct route with <to>.

   Imported by camel-context.xml via <import resource="classpath:camel/rest-api.xml"/>,
   then wired into the context by <restContextRef ref="restApiContext"/>.
  ============================================================================
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://camel.apache.org/schema/spring
           http://camel.apache.org/schema/spring/camel-spring.xsd">

    <restContext id="restApiContext" xmlns="http://camel.apache.org/schema/spring">

        <!--
          ====================================================================
          <rest> declares a group of REST endpoints; path is their common prefix.
                 It carries no business logic of its own - its whole job is to turn an
                 HTTP request into an Exchange and deliver it to a route.
          <post> declares a POST verb.
                 path      the sub-path appended after <rest path>
                 type      the type the request body is deserialised into
                 outType   the type of the response body (used for docs and validation)
                 It must contain exactly one <to>.
          <to>   sends the message to an Endpoint. Inside the REST DSL that means
                 "hand it over to this route". Everything here goes to a direct: endpoint,
                 which is a synchronous in-memory endpoint - calling it is equivalent to a
                 method call, and it is the first choice for carving out a sub-flow.
          ====================================================================
        -->
        <rest path="/api/v1/orders">

            <!-- API-1 the basic chain -->
            <post path="/basic" type="java.util.Map" outType="java.util.Map">
                <to uri="direct:api1-basic"/>
            </post>

            <!-- API-2 branching and filtering -->
            <post path="/dispatch" type="java.util.Map" outType="java.util.Map">
                <to uri="direct:api2-dispatch"/>
            </post>

            <!-- API-3 remote call through a ProducerTemplate -->
            <post path="/quote" type="java.util.Map" outType="java.util.Map">
                <to uri="direct:api3-quote"/>
            </post>

            <!-- API-4 parallel fan-out and result aggregation -->
            <post path="/check" type="java.util.Map" outType="java.util.Map">
                <to uri="direct:api4-check"/>
            </post>

            <!-- API-5 split, tap and dynamic routing -->
            <post path="/split" type="java.util.Map">
                <to uri="direct:api5-split"/>
            </post>

            <!-- API-6 the combined orchestration -->
            <post path="/fulfil" type="java.util.Map" outType="java.util.Map">
                <to uri="direct:api6-fulfil"/>
            </post>
        </rest>

    </restContext>
</beans>
